.env
*.pyc
__pycache__/
db.sqlite3
staticfiles/
.DS_Store
node_modules/
*.log
media/

# IDE / editor
.idea/
.vscode/

# Tooling (Claude Code)
.claude/

# Remotion promo build artifacts
.remotion/
.cache/

# Capacitor generated native project (recreated by `npx cap add` in CI).
# Only Android is wrapped this way. iOS is a real native app under /ios and is
# checked in — that path used to be ignored for a Capacitor shell that was
# never added, which would have silently swallowed every Swift file.
/android/
# Generated during the Android build from core/static/core/icon-dark.svg
assets/
android/
keystore.jks
key.properties

# Local cache from `wrangler dev`, rebuilt on demand.
.wrangler/

# Xcode build artifacts and per-developer state. The project file itself is
# checked in; none of this is.
ios/build/
ios/DerivedData/
ios/.swiftpm/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
