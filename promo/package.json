{
  "name": "trustfirst-promo",
  "version": "1.0.0",
  "description": "TrustFirst 60-second motion-graphics promo (Remotion → MP4)",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render TrustFirstPromo out/trustfirst-promo.mp4 --codec=h264",
    "render:hq": "remotion render TrustFirstPromo out/trustfirst-promo-hq.mp4 --codec=h264 --crf=16",
    "still": "remotion still TrustFirstPromo out/frame.png --frame=90",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "remotion": "4.0.484",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
